{
  "rules": {
    ".read": false,
    ".write": false,
    "test": {
      ".read": "auth != null",
      "taps": {
        ".write": "auth != null",
        "$tap": {
          ".validate": "newData.hasChildren(['team','uid','at']) && newData.child('team').val().matches(/^(dragon|tiger|robot)$/)"
        }
      },
      "presence": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
